# Never launch the vendor daemon directly. The wrapper maps modem NV/EFS
# partitions to verified read-only loop devices before starting rmt_storage.
service vendor.rmt_storage /vendor/bin/rmt_storage_ro.sh
    user root
    group system wakelock
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/vendor/odm/lib64:/bin
    seclabel u:r:recovery:s0
    namespace mnt
    disabled
