# Modem NV/EFS partitions are exposed read-only to rmt_storage.
service vendor.rmt_storage /system/bin/sh /vendor/bin/rmt_storage_ro.sh
    user root
    group system wakelock
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/vendor/odm/lib64:/bin
    seclabel u:r:recovery:s0
    namespace mnt
    disabled
