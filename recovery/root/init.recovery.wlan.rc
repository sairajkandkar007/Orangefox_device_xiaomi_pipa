# Load the Pipa WLAN stack only after OrangeFox has mounted vendor firmware.
on property:twrp.firmware.mounted=true && property:ro.twrp.fastbootd=0
    start wlan_setup

# Never auto-start vendor rmt_storage from recovery. It can write modem NV/EFS.
# The read-only wrapper is intentionally not started as part of WLAN bring-up.
on property:twrp.wlan.drivers.loaded=true
    write /dev/kmsg "[PIPA-WLAN] WLAN module loaded; starting CNSS support service; modem NV/EFS services remain stopped"
    start vendor.cnss-daemon

# OrangeFox raises this property when the user enables Wi-Fi.
on property:sys.fox.wlan.up=1
    write /dev/kmsg "[PIPA-WLAN] Starting wpa_supplicant"
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root
    restart wpa_supplicant
    setprop sys.fox.wlan.up 0

# Stock Pipa CNSS userspace companion for the QCA6390 WLAN driver.
service vendor.cnss-daemon /vendor/bin/cnss-daemon
    class late_start
    user root
    group root system wifi inet
    disabled
    seclabel u:r:recovery:s0
